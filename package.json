{
  "name": "react-native-apng-avif",
  "version": "1.0.0",
  "description": "Animated APNG and AVIF with full alpha transparency for React Native on Android, iOS and Web. One component plays both and reads the format from the file. New and old architecture.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index.tsx",
  "source": "src/index.tsx",
  "files": [
    "src",
    "lib",
    "android/src",
    "android/build.gradle",
    "ios",
    "react-native-apng-avif.podspec",
    "react-native.config.js",
    "THIRD_PARTY_NOTICES.md",
    "!**/__tests__",
    "!android/build",
    "!ios/build",
    "!.DS_Store"
  ],
  "scripts": {
    "build": "bob build",
    "typescript": "tsc --noEmit",
    "prepare": "bob build",
    "prepack": "bob build"
  },
  "codegenConfig": {
    "name": "RNApngAvifSpec",
    "type": "components",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "dev.mediacache.apngavif"
    },
    "ios": {
      "componentProvider": {
        "RNApngAvifView": "RNApngAvifViewComponentView"
      }
    }
  },
  "keywords": [
    "react-native",
    "apng",
    "avif",
    "animated-avif",
    "animated-png",
    "alpha",
    "transparency",
    "transparent-animation",
    "animation",
    "image",
    "react-native-component",
    "fabric",
    "android",
    "ios",
    "web",
    "react-native-web",
    "sdwebimage",
    "libavif"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MediaCacheDev/react-native-apng-avif.git"
  },
  "author": "Daniel Kasprowicz",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MediaCacheDev/react-native-apng-avif/issues"
  },
  "homepage": "https://www.alpha-video.dev",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.73"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "configFile": true
        }
      ],
      [
        "module",
        {
          "configFile": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/react": "^18.3.31",
    "react": "^18.2.0",
    "react-native": "^0.73.11",
    "react-native-builder-bob": "^0.23.2",
    "typescript": "^5.9.3"
  }
}
